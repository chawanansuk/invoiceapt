# Dev database (SQLite). For production use PostgreSQL:
#   DATABASE_URL="postgresql://user:pass@host:5432/dbname"
# and change `provider = "postgresql"` in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Vision OCR for payment slips + meter photos (optional).
# Get a key at https://console.anthropic.com/ . Without it, the app still works
# with manual entry — OCR buttons just report that the key is not configured.
ANTHROPIC_API_KEY=""
# Optional: override the OCR model (default claude-opus-4-8).
# For lower cost/latency at high volume, claude-haiku-4-5 also supports vision.
# ANTHROPIC_OCR_MODEL="claude-opus-4-8"
